---
import { navigation, siteConfig, services } from '../../data/site';
import Icon from '../ui/Icon.astro';
---

<footer class="site-footer border-t border-[var(--border)] bg-[var(--bg)]">
  <!-- Main Footer -->
  <div class="container site-footer__main">
    <!-- Link Columns -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-12">
      <!-- Services -->
      <div>
        <h4 class="type-eyebrow text-[var(--text)] mb-6">Services</h4>
        <ul class="space-y-4">
          {services.map((service) => (
            <li>
              <a
                href={`/services/${service.slug}/`}
                class="type-caption hover:text-[var(--text)] transition-colors duration-300"
              >
                {service.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="type-eyebrow text-[var(--text)] mb-6">Company</h4>
        <ul class="space-y-4">
          {navigation.filter(item => !item.children).map((item) => (
            <li>
              <a
                href={item.href}
                class="type-caption hover:text-[var(--text)] transition-colors duration-300"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="type-eyebrow text-[var(--text)] mb-6">Get in touch</h4>
        <ul class="space-y-4">
          <li>
            <a
              href={`tel:${siteConfig.phone.replace(/[^0-9]/g, '')}`}
              class="type-caption hover:text-[var(--text)] transition-colors duration-300"
            >
              {siteConfig.phone}
            </a>
          </li>
          <li>
            <a
              href={`mailto:${siteConfig.email}`}
              class="type-caption hover:text-[var(--text)] transition-colors duration-300"
            >
              {siteConfig.email}
            </a>
          </li>
          {siteConfig.address && (
            <li class="type-caption">
              {siteConfig.address}
            </li>
          )}
        </ul>
      </div>

      <!-- Social -->
      <div>
        <h4 class="type-eyebrow text-[var(--text)] mb-6">Social</h4>
        <ul class="space-y-4">
          {siteConfig.socials.map((social) => (
            <li>
              {social.url && social.url !== '#' ? (
                <a
                  href={social.url}
                  class="type-caption inline-flex items-center gap-2 hover:text-[var(--text)] transition-colors duration-300"
                  aria-label={social.platform}
                >
                  <Icon name={social.icon} size={14} />
                  {social.platform}
                </a>
              ) : (
                <span class="type-caption inline-flex items-center gap-2 text-[var(--text-secondary)]">
                  <Icon name={social.icon} size={14} aria-hidden="true" />
                  {social.platform}
                  <span class="type-meta">(coming soon)</span>
                </span>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-[var(--border)] py-5">
    <div class="container py-8">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-4">
          <a href="/" class="flex items-center gap-2" aria-label="SoCal Web Experts home">
            <img 
              src="/logo-white.png" 
              alt="SoCal Web Experts"
              width="64"
              height="64"
              style="height: 64px; width: auto;"
            />
          </a>
          <span class="type-meta">© {new Date().getFullYear()} {siteConfig.name}</span>
        </div>
        <div class="type-meta flex items-center gap-6">
          <span class="flex items-center gap-1.5">
            <span class="type-caption">🇺🇸</span>
            Proudly Made in USA
          </span>
          <a href="/site-map/" class="hover:text-[var(--text)] transition-colors duration-300">Sitemap</a>
          <a href="/accessibility/" class="hover:text-[var(--text)] transition-colors duration-300">Accessibility</a>
          <a href="/privacy/" class="hover:text-[var(--text)] transition-colors duration-300">Privacy</a>
          <a href="/terms/" class="hover:text-[var(--text)] transition-colors duration-300">Terms</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Padding on section wrappers — global .container resets vertical padding to 0 */
  .site-footer__main {
    padding-top: 5rem;
    padding-bottom: 5rem;
  }

  @media (min-width: 768px) {
    .site-footer__main {
      padding-top: 6.5rem;
      padding-bottom: 6.5rem;
    }
  }
</style>
