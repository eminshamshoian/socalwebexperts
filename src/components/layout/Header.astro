---
import { navigation, siteConfig } from '../../data/site';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
---

<header class="site-header" id="header">
  <nav class="group" data-scrolled="false" aria-label="Primary">
    <!-- Inner container: full-width → shrinks to pill on scroll -->
    <div
      id="nav-inner"
      class="mx-auto mt-2 max-w-6xl px-6 transition-all duration-300 lg:px-12"
    >
      <div class="relative flex flex-wrap items-center justify-between gap-6 pt-3 pb-6 lg:gap-0 lg:py-4">

        <!-- Logo -->
        <a href="/" class="flex items-center gap-2.5 group/logo z-10" aria-label="SoCal Web Experts home">
          <img
            src="/logo-white.webp"
            alt="SoCal Web Experts"
            width="192"
            height="192"
            style="height: 96px; width: auto;"
            decoding="async"
            fetchpriority="high"
          />
        </a>

        <!-- Desktop Navigation -->
        <div class="absolute inset-0 m-auto hidden size-fit lg:block">
          <ul class="flex gap-1 text-sm">
            {navigation.map((item) => (
              item.children ? (
                <li class="relative group/dd" data-nav-dropdown>
                  <button
                    type="button"
                    class="flex items-center gap-1.5 px-4 py-2 text-[13px] tracking-wide uppercase font-medium text-[var(--text-secondary)] hover:text-[var(--text)] transition-colors duration-300"
                    aria-expanded="false"
                    aria-haspopup="true"
                    data-nav-dropdown-trigger
                  >
                    {item.label}
                    <Icon name="chevron-down" size={12} class="transition-transform duration-300 group-hover/dd:rotate-180" />
                  </button>
                  <div
                    class="absolute top-full left-0 pt-3 opacity-0 invisible group-hover/dd:opacity-100 group-hover/dd:visible group-focus-within/dd:opacity-100 group-focus-within/dd:visible transition-all duration-300 translate-y-1 group-hover/dd:translate-y-0 group-focus-within/dd:translate-y-0"
                  >
                    <div class="bg-[var(--bg)] border border-[var(--border)] rounded-2xl shadow-2xl shadow-black/20 py-2 min-w-[200px] backdrop-blur-xl">
                      {item.children.map((child) => (
                        <a
                          href={child.href}
                          class="block px-4 py-2.5 text-sm text-[var(--text-secondary)] hover:text-primary-500 hover:bg-[var(--bg-secondary)] transition-all duration-200"
                        >
                          {child.label}
                        </a>
                      ))}
                    </div>
                  </div>
                </li>
              ) : (
                <li>
                  <a
                    href={item.href}
                    class="block px-4 py-2 text-[13px] tracking-wide uppercase font-medium text-[var(--text-secondary)] hover:text-[var(--text)] transition-colors duration-300"
                  >
                    {item.label}
                  </a>
                </li>
              )
            ))}
          </ul>
        </div>

        <!-- Right Side -->
        <div class="flex items-center gap-2">
          <a
            href="/contact/"
            id="header-cta"
            class="text-sm font-medium px-5 py-2.5 rounded-md bg-primary-500 text-on-primary transition-all duration-150 shadow-[3px_3px_0px_0px_#A35139] hover:shadow-[1px_1px_0px_0px_#A35139] hover:translate-x-[2px] hover:translate-y-[2px]"
          >
            Let's Discuss
          </a>

          <!-- Mobile menu button -->
          <button
            id="mobile-menu-btn"
            type="button"
            class="lg:hidden p-2.5 rounded-xl text-[var(--text)] hover:bg-[var(--bg-secondary)] transition-colors z-10"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <Icon name="menu" size={22} class="menu-icon" />
            <Icon name="close" size={22} class="close-icon hidden" />
          </button>
        </div>
      </div>
    </div>
  </nav>
</header>

<!--
  Mobile menu lives outside .site-header so header backdrop-filter
  does not create a containing block that traps position:fixed.
-->
<div
  id="mobile-menu"
  class="mobile-menu lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-label="Mobile navigation"
>
  <div class="mobile-menu__panel">
    <button
      id="mobile-menu-close"
      type="button"
      class="mobile-menu__close"
      aria-label="Close menu"
    >
      <Icon name="close" size={24} />
    </button>

    <!-- Navigation -->
    <nav class="mobile-menu__nav" aria-label="Mobile">
      {navigation.map((item, idx) => (
        item.children ? (
          <div class="mobile-nav-item">
            <button
              type="button"
              class="mobile-nav-link mobile-dropdown-trigger"
              data-dropdown={`dropdown-${idx}`}
              aria-expanded="false"
              aria-controls={`dropdown-${idx}`}
              style={`animation-delay: ${idx * 60}ms`}
            >
              <span>{item.label}</span>
              <Icon name="chevron-down" size={22} class="dropdown-icon shrink-0 transition-transform duration-300" />
            </button>
            <div
              class="mobile-dropdown-content hidden"
              id={`dropdown-${idx}`}
            >
              {item.children.map((child) => (
                <a
                  href={child.href}
                  class="mobile-nav-sublink"
                >
                  {child.label}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class="mobile-nav-link"
            style={`animation-delay: ${idx * 60}ms`}
          >
            {item.label}
          </a>
        )
      ))}
    </nav>

    <!-- Bottom Section -->
    <div class="mobile-menu__footer">
      <a
        href={`tel:${siteConfig.phone.replace(/[^0-9]/g, '')}`}
        class="flex items-center gap-2 text-[var(--text)]"
      >
        <Icon name="phone" size={16} class="text-primary-500" />
        <span class="text-sm">{siteConfig.phone}</span>
      </a>
      <Button href="/contact/" fullWidth size="lg">
        Let's Discuss
      </Button>
    </div>
  </div>
</div>

<!-- Spacer so page content clears the fixed header -->
<div class="site-header-spacer" aria-hidden="true"></div>

<style>
  /* Fixed/sticky nav — pinned to the top on mobile and desktop */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    width: 100%;
    padding-left: 0.5rem;
    padding-right: 0.5rem;
    background: rgba(var(--bg-rgb, 27, 38, 50), 0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .site-header-spacer {
    height: 7.5rem;
  }

  @media (min-width: 1024px) {
    .site-header-spacer {
      height: 8rem;
    }
  }

  /* Pill nav on scroll */
  #nav-inner.scrolled {
    max-width: 56rem; /* ~max-w-4xl equivalent */
    border-radius: 1rem;
    border: 1px solid var(--border);
    background: rgba(var(--bg-rgb, 10, 10, 10), 0.6);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }

  /* Full-viewport opaque mobile menu (sibling of header, not trapped by backdrop-filter) */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 40;
    width: 100%;
    height: 100%;
    height: 100dvh;
    background-color: var(--bg);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .mobile-menu.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  @media (min-width: 1024px) {
    .mobile-menu {
      display: none !important;
    }
  }

  .mobile-menu__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 6rem 2rem 2rem;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    background-color: var(--bg);
  }

  .mobile-menu__close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 50;
    padding: 0.625rem;
    border: 0;
    border-radius: 0.75rem;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  .mobile-menu__close:hover {
    background: var(--bg-secondary);
  }

  .mobile-menu__nav {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-start;
    padding-top: clamp(1rem, 6vh, 4rem);
  }

  .mobile-menu__footer {
    border-top: 1px solid var(--border);
    padding: 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Shared type for every top-level item (links AND the Services button).
     Explicit font-size here so form-control resets cannot shrink Services. */
  .mobile-nav-link {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0;
    border: 0;
    background: transparent;
    padding: 1rem 0;
    font-family: inherit;
    font-size: 2.25rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: inherit;
    color: var(--text);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s ease, transform 0.4s ease, color 0.2s ease;
  }

  .mobile-nav-link:hover {
    color: var(--color-primary-500);
  }

  #mobile-menu.open .mobile-nav-link {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-dropdown-content {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    margin-left: 0.25rem;
    border-left: 1px solid var(--border);
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 1.25rem;
    transition: max-height 0.3s ease, opacity 0.2s ease, padding 0.3s ease;
  }

  .mobile-dropdown-content.open {
    max-height: 20rem;
    opacity: 1;
    padding-top: 0.25rem;
    padding-bottom: 0.5rem;
  }

  .mobile-nav-sublink {
    display: block;
    padding: 0.75rem 0;
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.3;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .mobile-nav-sublink:hover {
    color: var(--color-primary-500);
  }

  .mobile-dropdown-trigger.active .dropdown-icon {
    transform: rotate(180deg);
  }

  :global(html.mobile-menu-open),
  :global(html.mobile-menu-open body) {
    overflow: hidden;
    overscroll-behavior: none;
  }
</style>

<script>
  function lockPageScroll() {
    document.documentElement.classList.add('mobile-menu-open');
  }

  function unlockPageScroll() {
    document.documentElement.classList.remove('mobile-menu-open');
  }

  function setMobileMenuState(open, restoreFocus = true) {
    const menu = document.getElementById('mobile-menu');
    const btn = document.getElementById('mobile-menu-btn');
    const menuIcon = btn?.querySelector('.menu-icon');
    const closeIcon = btn?.querySelector('.close-icon');

    if (!menu || !btn || !menuIcon || !closeIcon) return;

    if (open) {
      menu.classList.add('open');
      menuIcon.classList.add('hidden');
      closeIcon.classList.remove('hidden');
      menu.setAttribute('aria-hidden', 'false');
      btn.setAttribute('aria-expanded', 'true');
      btn.setAttribute('aria-label', 'Close menu');
      lockPageScroll();
      const firstFocusable = menu.querySelector('a, button, input, select, textarea');
      if (firstFocusable instanceof HTMLElement) firstFocusable.focus();
    } else {
      menu.classList.remove('open');
      menu.setAttribute('aria-hidden', 'true');
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', 'Open menu');
      menuIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
      unlockPageScroll();
      if (restoreFocus) btn.focus({ preventScroll: true });
    }
  }

  function closeMobileMenu(restoreFocus = true) {
    setMobileMenuState(false, restoreFocus);
  }

  function initMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('mobile-menu-close');
    const menu = document.getElementById('mobile-menu');

    if (btn && menu) {
      btn.addEventListener('click', () => {
        const isOpen = btn.getAttribute('aria-expanded') === 'true';
        setMobileMenuState(!isOpen);
      });
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', () => { closeMobileMenu(); });
    }

    if (menu) {
      menu.querySelectorAll('a.mobile-nav-link, .mobile-dropdown-content a').forEach(link => {
        link.addEventListener('click', () => { closeMobileMenu(false); });
      });
    }

    if (!document.documentElement.hasAttribute('data-mobile-menu-escape-init')) {
      document.documentElement.setAttribute('data-mobile-menu-escape-init', '');
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          const currentMenu = document.getElementById('mobile-menu');
          if (currentMenu?.classList.contains('open')) closeMobileMenu();
        }
      });
    }

    const dropdownTriggers = document.querySelectorAll('.mobile-dropdown-trigger');
    dropdownTriggers.forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const dropdownId = trigger.getAttribute('data-dropdown');
        const dropdown = dropdownId ? document.getElementById(dropdownId) : null;

        if (dropdown) {
          const isOpen = dropdown.classList.contains('open');
          document.querySelectorAll('.mobile-dropdown-content').forEach(dd => {
            if (dd !== dropdown) {
              dd.classList.remove('open');
              dd.classList.add('hidden');
            }
          });
          document.querySelectorAll('.mobile-dropdown-trigger').forEach(tr => {
            if (tr !== trigger) {
              tr.classList.remove('active');
              tr.setAttribute('aria-expanded', 'false');
            }
          });

          if (isOpen) {
            dropdown.classList.remove('open');
            dropdown.classList.add('hidden');
            trigger.classList.remove('active');
            trigger.setAttribute('aria-expanded', 'false');
          } else {
            dropdown.classList.remove('hidden');
            requestAnimationFrame(() => { dropdown.classList.add('open'); });
            trigger.classList.add('active');
            trigger.setAttribute('aria-expanded', 'true');
          }
        }
      });
    });
  }

  function initHeaderScroll() {
    const navInner = document.getElementById('nav-inner');
    if (!navInner) return;

    const onScroll = () => {
      navInner.classList.toggle('scrolled', window.scrollY > 50);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
  }

  function initDesktopDropdownA11y() {
    document.querySelectorAll('[data-nav-dropdown]').forEach((parent) => {
      const trigger = parent.querySelector('[data-nav-dropdown-trigger]');
      if (!trigger) return;

      parent.addEventListener('mouseenter', () => trigger.setAttribute('aria-expanded', 'true'));
      parent.addEventListener('mouseleave', () => trigger.setAttribute('aria-expanded', 'false'));
      parent.addEventListener('focusin', () => trigger.setAttribute('aria-expanded', 'true'));
      parent.addEventListener('focusout', () => {
        window.setTimeout(() => {
          if (!parent.contains(document.activeElement)) {
            trigger.setAttribute('aria-expanded', 'false');
          }
        }, 0);
      });
    });
  }

  initMobileMenu();
  initHeaderScroll();
  initDesktopDropdownA11y();

  document.addEventListener('astro:after-swap', () => {
    initMobileMenu();
    initHeaderScroll();
    initDesktopDropdownA11y();
  });
</script>
