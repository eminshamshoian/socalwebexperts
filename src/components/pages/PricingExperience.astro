---
import { faqItems } from '../../data/site';
import { Plus } from '@lucide/astro';
import SiteIcon from '../ui/SiteIcon.astro';
import PricingCards from '../ui/PricingCards.astro';

interface Props {
  layout?: 'pricing' | 'start';
}

const { layout = 'pricing' } = Astro.props;

const addOns = [
  { title: 'Google Ads', price: 'From $500 per month', desc: 'Campaign setup, optimization, and conversion tracking.', icon: 'target' },
  { title: 'Social Media', price: 'From $400 per month', desc: 'Content planning, creation, and a consistent posting schedule.', icon: 'share' },
  { title: 'Ecommerce', price: 'From $2,500', desc: 'Shopify setup with payment, product, and shipping configuration.', icon: 'code' },
];
---

{layout === 'pricing' && (
  <section class="pricing-page-hero section-shell page-title-section">
    <div class="site-container">
      <h1 data-reveal>Professional websites without the agency markup.</h1>
      <p class="type-lead" data-reveal>One $150 buildout. Pick $50 a month for everything, or $15 a month for hosting and maintenance.</p>
    </div>
  </section>
)}

<section class:list={['pricing-main', 'section-shell', layout === 'pricing' && 'section-rule', layout === 'start' && 'pricing-main--start']}>
  <div class="site-container">
    <PricingCards />
  </div>
</section>

{layout === 'pricing' && (
<>
<section class="add-ons section-shell">
  <div class="site-container">
    <div class="add-ons__head">
      <p class="section-index" data-reveal>Optional growth services</p>
      <h2 data-reveal>Build on the foundation.</h2>
    </div>
    <div class="add-ons__list">
      {addOns.map((item, index) => (
        <article data-reveal style={`--reveal-delay:${index * 60}ms`}>
          <SiteIcon name={item.icon} />
          <div><h3>{item.title}</h3><p>{item.desc}</p></div>
          <strong>{item.price}</strong>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="pricing-faq section-shell section-rule">
  <div class="site-container">
    <div class="pricing-faq__head">
      <p class="section-index">Before you decide</p>
      <h2>Common pricing questions.</h2>
    </div>
    <div class="pricing-faq__items">
      {faqItems.slice(1, 6).map((faq, index) => (
        <details data-reveal style={`--reveal-delay:${index * 50}ms`}>
          <summary>{faq.question}<Plus aria-hidden="true" /></summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
</>
)}

<style>
  .pricing-page-hero h1 {
    max-width: 12ch;
  }

  .pricing-page-hero .type-lead {
    max-width: 32rem;
    margin-top: 1.25rem;
  }

  .pricing-main--start {
    padding-top: 2.5rem;
  }
  .add-ons__head,
  .pricing-faq__head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .add-ons__head h2,
  .pricing-faq__head h2 {
    max-width: 10ch;
  }

  .add-ons__list,
  .pricing-faq__items {
    display: grid;
    gap: 0.75rem;
  }

  .add-ons article {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    padding: 2rem;
    background: var(--bg-secondary);
  }

  .add-ons article p {
    color: var(--text-secondary);
    font-size: var(--type-sm);
    font-weight: var(--weight-regular);
  }

  .add-ons h3 {
    margin-bottom: 0.6rem;
    font-weight: var(--weight-bold);
  }

  .add-ons strong {
    grid-column: 2;
    font-size: var(--type-sm);
    font-weight: var(--weight-bold);
  }

  .pricing-faq details {
    padding-inline: 1.25rem;
    background: var(--bg-secondary);
  }

  .pricing-faq summary {
    display: grid;
    grid-template-columns: 1fr auto;
    padding-block: 1.5rem;
    cursor: pointer;
    font-size: var(--type-md);
    font-weight: var(--weight-bold);
    list-style: none;
  }

  .pricing-faq summary::-webkit-details-marker {
    display: none;
  }

  .pricing-faq summary :global(svg) {
    color: var(--text-secondary);
    width: 1rem;
    height: 1rem;
    transition: transform 180ms ease;
  }

  .pricing-faq details[open] summary :global(svg) {
    transform: rotate(45deg);
  }

  .pricing-faq details > p {
    max-width: 40rem;
    padding: 0 0 1.5rem 2.5rem;
    color: var(--text-secondary);
    font-size: var(--type-sm);
    font-weight: var(--weight-regular);
  }

  @media (min-width: 800px) {
    .add-ons__head,
    .pricing-faq__head {
      grid-template-columns: 0.6fr 1.4fr;
    }

    .add-ons article {
      grid-template-columns: 3rem 1fr auto;
    }

    .add-ons strong {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
