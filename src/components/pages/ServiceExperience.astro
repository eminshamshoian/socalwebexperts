---
import type { Service } from '../../types';
import { services } from '../../data/site';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const related = services.filter((item) => item.id !== service.id);

const imageUrl = (src: string, width: number) => {
  const url = new URL(src);
  url.searchParams.set('auto', 'format');
  url.searchParams.set('fit', 'crop');
  url.searchParams.set('w', String(width));
  url.searchParams.set('q', '78');
  return url.toString();
};
---

<article class="service-experience">
  <section class="service-experience__hero section-shell">
    <div class="site-container">
      <p class="section-index texture-tag" data-reveal>Service / {service.title}</p>
      <div class="service-experience__hero-grid">
        <div data-reveal>
          <h1>{service.heroHeadline}</h1>
          <p class="type-lead">{service.description}</p>
          <div class="service-experience__actions">
            <a class="button" href="/contact/">Start a project</a>
            <a href="#capabilities">Explore capabilities ↓</a>
          </div>
        </div>
        <div class="service-experience__hero-image" data-reveal style="--reveal-delay:100ms">
          <img
            src={imageUrl(service.highlights[0].image, 1200)}
            srcset={[480, 768, 1200].map((width) => `${imageUrl(service.highlights[0].image, width)} ${width}w`).join(', ')}
            sizes="(max-width: 900px) calc(100vw - 2rem), 45vw"
            width="1200"
            height="900"
            alt={service.highlights[0].imageAlt}
            loading="eager"
            decoding="async"
          />
          <span>01 / {service.title}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="service-experience__features section-shell section-rule">
    <div class="site-container">
      <div class="service-experience__section-head">
        <p class="section-index" data-reveal>How it helps</p>
        <h2 data-reveal>A complete system, not a disconnected deliverable.</h2>
      </div>
      <div class="service-experience__feature-grid">
        {service.highlights.map((item, index) => (
          <article data-reveal style={`--reveal-delay:${index * 55}ms`}>
            <div>
              <img
                data-parallax="15"
                src={imageUrl(item.image, 900)}
                srcset={[480, 720, 900].map((width) => `${imageUrl(item.image, width)} ${width}w`).join(', ')}
                sizes="(max-width: 760px) calc(100vw - 2rem), 46vw"
                width="900"
                height="680"
                alt={item.imageAlt}
                loading="lazy"
                decoding="async"
              />
            </div>
            <span>0{index + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="service-experience__capabilities section-shell section-rule" id="capabilities">
    <div class="site-container">
      <div class="service-experience__section-head">
        <p class="section-index" data-reveal>Capabilities</p>
        <h2 data-reveal>What is included in the work.</h2>
      </div>
      <div class="service-experience__capability-list">
        {service.details.map((detail, index) => (
          <article data-reveal style={`--reveal-delay:${index * 45}ms`}>
            <span>0{index + 1}</span>
            <h3>{detail.title}</h3>
            <p>{detail.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="service-experience__included section-shell">
    <div class="site-container">
      <div class="service-experience__section-head">
        <p class="section-index" data-reveal>Deliverables</p>
        <h2 data-reveal>Everything needed to move forward confidently.</h2>
      </div>
      <ol>
        {service.features.map((feature, index) => <li data-reveal><span>0{index + 1}</span>{feature}</li>)}
      </ol>
    </div>
  </section>

  <section class="service-experience__related section-shell section-rule">
    <div class="site-container">
      <p class="section-index">Keep exploring</p>
      <div>
        {related.map((item, index) => (
          <a href={`/services/${item.slug}/`}>
            <span>0{index + 1}</span>
            <h2>{item.title}</h2>
            <b>↗</b>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="service-experience__cta section-shell">
    <div class="site-container">
      <p class="section-index">Ready when you are</p>
      <h2>Let us turn the next idea into something useful.</h2>
      <a class="button" href="/contact/">Start a conversation</a>
    </div>
  </section>
</article>

<style>
  .service-experience__hero {
    padding-top: clamp(4rem, 8vw, 8rem);
  }

  .service-experience__hero-grid {
    display: grid;
    gap: 4rem;
    margin-top: 2rem;
  }

  .service-experience__hero h1 {
    max-width: 11ch;
    font-size: clamp(3rem, 7vw, 7rem);
  }

  .service-experience__hero .type-lead {
    max-width: 38rem;
    margin-top: 2rem;
  }

  .service-experience__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .service-experience__actions > a:last-child {
    font-size: 0.78rem;
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .service-experience__hero-image {
    position: relative;
    min-height: 28rem;
    padding: clamp(1rem, 3vw, 2.5rem);
    background: var(--accent-soft);
  }

  .service-experience__hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.82);
  }

  .service-experience__hero-image span {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    padding: 0.5rem 0.7rem;
    background: #fff;
    font-size: 0.65rem;
  }

  .service-experience__section-head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(4rem, 8vw, 8rem);
  }

  .service-experience__section-head h2 {
    max-width: 12ch;
  }

  .service-experience__feature-grid {
    display: grid;
    gap: 5rem 1.25rem;
  }

  .service-experience__feature-grid article > div {
    height: clamp(22rem, 60vw, 38rem);
    overflow: hidden;
    background: var(--bg-secondary);
  }

  .service-experience__feature-grid img {
    width: 100%;
    height: calc(100% + 2rem);
    object-fit: cover;
  }

  .service-experience__feature-grid article > span {
    display: block;
    margin-top: 1rem;
    color: var(--text-secondary);
    font-size: 0.65rem;
  }

  .service-experience__feature-grid h3 {
    margin-top: 1rem;
  }

  .service-experience__feature-grid p {
    max-width: 34rem;
    margin-top: 0.8rem;
    color: var(--text-secondary);
    font-size: 0.86rem;
  }

  .service-experience__capabilities {
    background: var(--bg-secondary);
  }

  .service-experience__capability-list {
    border-top: 1px solid var(--border);
  }

  .service-experience__capability-list article {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    border-bottom: 1px solid var(--border);
    padding-block: 2rem;
  }

  .service-experience__capability-list span,
  .service-experience__capability-list p {
    color: var(--text-secondary);
    font-size: 0.75rem;
  }

  .service-experience__capability-list p {
    grid-column: 2;
    max-width: 31rem;
  }

  .service-experience__included {
    background: var(--text);
    color: #fff;
  }

  .service-experience__included h2 {
    color: #fff;
  }

  .service-experience__included .section-index {
    color: rgba(255, 255, 255, 0.55);
  }

  .service-experience__included ol {
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    list-style: none;
  }

  .service-experience__included li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    border-bottom: 1px solid rgba(255, 255, 255, 0.22);
    padding-block: 1.3rem;
    font-size: clamp(1rem, 1.5vw, 1.3rem);
  }

  .service-experience__included li span {
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.65rem;
  }

  .service-experience__related > div > p {
    margin-bottom: 2rem;
  }

  .service-experience__related > div > div {
    border-top: 1px solid var(--border);
  }

  .service-experience__related a {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: center;
    border-bottom: 1px solid var(--border);
    padding-block: 1.5rem;
    transition: padding 220ms ease, background-color 220ms ease;
  }

  .service-experience__related a:hover {
    padding-inline: 1rem;
    background: var(--bg-secondary);
  }

  .service-experience__related a span {
    color: var(--text-secondary);
    font-size: 0.65rem;
  }

  .service-experience__related h2 {
    font-size: clamp(1.8rem, 4vw, 4rem);
  }

  .service-experience__related b {
    font-weight: 500;
  }

  .service-experience__cta {
    background: var(--accent);
    color: #fff;
  }

  .service-experience__cta h2 {
    max-width: 12ch;
    margin-block: 1.5rem 2.5rem;
    color: #fff;
  }

  .service-experience__cta .section-index {
    color: rgba(255, 255, 255, 0.65);
  }

  .service-experience__cta .button {
    border-color: #fff;
    color: #fff;
  }

  .service-experience__cta .button:hover {
    background: #fff;
    color: var(--accent);
  }

  @media (min-width: 800px) {
    .service-experience__hero-grid {
      grid-template-columns: 1fr 0.8fr;
      align-items: center;
    }

    .service-experience__section-head {
      grid-template-columns: 0.6fr 1.4fr;
    }

    .service-experience__feature-grid {
      grid-template-columns: 1fr 1fr;
    }

    .service-experience__feature-grid article:nth-child(even) {
      margin-top: 7rem;
    }

    .service-experience__feature-grid article > div {
      height: 34rem;
    }

    .service-experience__capability-list article {
      grid-template-columns: 3rem 0.8fr 1fr;
    }

    .service-experience__capability-list p {
      grid-column: 3;
    }
  }
</style>
