<script>
  function initHeroReel() {
    const reel = document.querySelector<HTMLElement>('[data-hero-reel]');
    const track = reel?.querySelector<HTMLElement>('[data-hero-reel-track]');
    if (!reel || !track || reel.dataset.ready) return;
    reel.dataset.ready = 'true';

    const items = Array.from(track.querySelectorAll<HTMLElement>('[data-hero-reel-item]'));
    const half = items.length / 2;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cruiseSpeed = reduceMotion ? 0 : 0.045;

    let centers: number[] = [];
    let loop = 0;
    let reelWidth = 0;
    let offset = 0;
    let speed = cruiseSpeed;
    let targetSpeed = cruiseSpeed;
    let dragging = false;
    let dragged = false;
    let startX = 0;
    let startOffset = 0;
    let lastX = 0;
    let lastTime = 0;
    let velocity = 0;
    let frame = 0;
    let previous = 0;

    const measure = () => {
      reelWidth = reel.clientWidth;
      loop = items[half].offsetLeft - items[0].offsetLeft;
      centers = items.map((item) => item.offsetLeft + item.offsetWidth / 2);
    };

    const wrap = () => {
      if (!loop) return;
      while (offset <= -loop) {
        offset += loop;
        startOffset += loop;
      }
      while (offset > 0) {
        offset -= loop;
        startOffset -= loop;
      }
    };

    // Cards follow an arch: position and rotation change, size never does.
    const render = () => {
      track.style.transform = `translate3d(${offset.toFixed(2)}px, 0, 0)`;
      const halfWidth = reelWidth / 2;
      const depth = Math.min(reelWidth * 0.055, 64);
      items.forEach((item, index) => {
        const distance = Math.max(-1.6, Math.min(1.6, (centers[index] + offset - halfWidth) / halfWidth));
        const lift = distance * distance * depth;
        item.style.transform = `translate3d(0, ${lift.toFixed(2)}px, 0) rotate(${(distance * 6).toFixed(2)}deg)`;
      });
    };

    const tick = (time: number) => {
      const delta = Math.min(time - (previous || time), 50);
      previous = time;
      if (!dragging) {
        speed += (targetSpeed - speed) * 0.05;
        offset -= speed * delta;
      }
      wrap();
      render();
      frame = requestAnimationFrame(tick);
    };

    const start = () => {
      if (frame) return;
      previous = 0;
      frame = requestAnimationFrame(tick);
    };

    const stop = () => {
      cancelAnimationFrame(frame);
      frame = 0;
    };

    reel.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse') targetSpeed = 0;
    });
    reel.addEventListener('pointerleave', (event) => {
      if (event.pointerType === 'mouse') targetSpeed = cruiseSpeed;
    });

    reel.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      dragging = true;
      dragged = false;
      startX = lastX = event.clientX;
      startOffset = offset;
      lastTime = performance.now();
      velocity = 0;
    });

    window.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      const distance = event.clientX - startX;
      if (!dragged && Math.abs(distance) > 6) {
        dragged = true;
        reel.classList.add('is-dragging');
      }
      if (!dragged) return;
      offset = startOffset + distance;
      const now = performance.now();
      velocity = (event.clientX - lastX) / Math.max(1, now - lastTime);
      lastX = event.clientX;
      lastTime = now;
    });

    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      reel.classList.remove('is-dragging');
      if (dragged) speed = Math.max(-2, Math.min(2, -velocity));
    };
    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);

    reel.addEventListener('click', (event) => {
      if (!dragged) return;
      event.preventDefault();
      event.stopPropagation();
      dragged = false;
    }, true);

    reel.addEventListener('dragstart', (event) => event.preventDefault());

    measure();
    render();
    new ResizeObserver(() => {
      measure();
      render();
    }).observe(reel);

    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) start();
      else stop();
    }).observe(reel);
  }

  initHeroReel();
</script>
