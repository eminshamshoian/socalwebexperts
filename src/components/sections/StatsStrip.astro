---
import { stats } from '../../data/site';

const marks = [
  // Launch — open frame / viewport
  `<rect x="3.5" y="4.5" width="13" height="11" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.25"/>
   <path d="M3.5 7.5h13" fill="none" stroke="currentColor" stroke-width="1.25"/>`,
  // Hosted — stacked layers
  `<path d="M10 3.5l6.5 3.25L10 10 3.5 6.75 10 3.5z" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>
   <path d="M3.5 10.25L10 13.5l6.5-3.25" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>
   <path d="M3.5 13.25L10 16.5l6.5-3.25" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>`,
  // Come back — return arc
  `<path d="M14.5 7.5A4.75 4.75 0 1 0 15 12.25" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
   <path d="M12.25 5.25L14.75 7.5l-2.5 2.25" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>`,
];
---

<section class="stats-section py-20 md:py-28" aria-labelledby="stats-heading">
  <div class="mx-auto w-full max-w-[1400px] px-6 lg:px-16">
    <div class="fade-in text-center mb-12 md:mb-16">
      <p class="type-eyebrow mb-4">Results</p>
      <h2 id="stats-heading" class="text-[var(--text)]">
        By the numbers
      </h2>
    </div>

    <div class="stats-grid">
      {stats.map((stat, index) => (
        <article
          class="stats-card fade-in"
          style={`animation-delay: ${0.08 + index * 0.06}s`}
        >
          <svg
            class="stats-card__mark"
            viewBox="0 0 20 20"
            width="18"
            height="18"
            aria-hidden="true"
            set:html={marks[index] ?? marks[0]}
          />

          <p class="stats-card__label">{stat.label}</p>
          <p class="stats-card__value">
            {stat.value}{stat.suffix && <span>{stat.suffix}</span>}
          </p>
          <p class="stats-card__desc">{stat.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .stats-section {
    background: var(--bg);
    border-block: 1px solid var(--border);
  }

  .stats-grid {
    display: grid;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 1rem;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .stats-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 100%;
    padding: 1.75rem 1.5rem 2rem;
    background: var(--bg);
  }

  @media (min-width: 768px) {
    .stats-card {
      padding: 2.25rem 2rem 2.5rem;
    }
  }

  .stats-card__mark {
    position: absolute;
    top: 1.35rem;
    right: 1.35rem;
    color: var(--text-secondary);
    opacity: 0.4;
  }

  .stats-card__label {
    margin: 0 0 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-primary-500);
  }

  .stats-card__value {
    margin: 0 0 0.85rem;
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--text);
  }

  .stats-card__value span {
    font-weight: 400;
    color: var(--text);
    opacity: 0.55;
  }

  .stats-card__desc {
    margin: 0;
    max-width: 30ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    font-weight: 400;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .stats-card__desc {
      font-size: 1rem;
    }
  }
</style>
