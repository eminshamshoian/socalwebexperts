---
import {
  ChartBar,
  CircleCheck,
  CircleDollarSign,
  Clock,
  CodeXml,
  Gauge,
  MapPin,
  Palette,
  Pencil,
  Phone,
  RefreshCw,
  Rocket,
  Search,
  Share2,
  ShieldCheck,
  Star,
  Target,
  TrendingUp,
  Users,
  Zap,
} from '@lucide/astro';

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;

const icons = {
  'bar-chart': ChartBar,
  'check-circle': CircleCheck,
  'circle-dollar-sign': CircleDollarSign,
  clock: Clock,
  code: CodeXml,
  edit: Pencil,
  gauge: Gauge,
  'map-pin': MapPin,
  palette: Palette,
  phone: Phone,
  'refresh-cw': RefreshCw,
  rocket: Rocket,
  search: Search,
  share: Share2,
  shield: ShieldCheck,
  star: Star,
  target: Target,
  'trending-up': TrendingUp,
  users: Users,
  zap: Zap,
} as const;

const Icon = icons[name as keyof typeof icons] ?? CircleCheck;
---

<Icon size={size} class={className} aria-hidden="true" />
