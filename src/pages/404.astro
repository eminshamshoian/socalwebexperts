---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | SoCal Web Experts"
  description="The page you are looking for could not be found. Return home or contact SoCal Web Experts."
  noindex={true}
>
  <section class="section-shell">
    <div class="site-container" style="max-width: 900px; text-align: center;">
      <p class="section-index" style="margin-bottom: 1.5rem;">404 / Wrong turn</p>
      <h1 style="margin-bottom: 1.5rem;">Page not found.</h1>
      <p class="type-lead" style="max-width: 40rem; margin: 0 auto 2.5rem;">
        That URL does not exist. Try the homepage or get in touch and we will help you find what you need.
      </p>
      <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem;">
        <a class="button" href="/">Go home</a>
        <a class="button" href="/contact/">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>
