---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../data/site';

const nextSteps = [
  { title: 'We review your details', body: 'You will hear from us within one business day.' },
  { title: 'We kick off the build', body: 'Most sites are live in 2 to 5 business days once we have your content.' },
  { title: 'You review before launch', body: 'Nothing goes live until you have signed off on it.' },
];

const prepare = [
  'Your logo, if you have one',
  'Photos of your work, team, or location',
  'A list of the services you offer',
  'Your current domain and where it is registered',
  'Any reviews or testimonials you would like to show',
];
---

<BaseLayout
  title="You're In | SoCal Web Experts"
  description="Thanks for getting started with SoCal Web Experts. Book your free strategy call and see what happens next."
  noindex={true}
>
  <section class="thanks-hero section-shell page-title-section page-hero-compact">
    <div class="site-container">
      <p class="section-index" data-reveal>Details received</p>
      <h1 data-reveal>You're in<span data-thanks-name></span>.</h1>
      <p class="type-lead" data-reveal>
        We have your details. The fastest way to move forward is a quick call, so pick a time that works for you.
      </p>
    </div>
  </section>

  <section class="thanks-book section-shell section-rule" aria-labelledby="book-title">
    <div class="site-container">
      <h2 id="book-title">Book your free strategy call.</h2>
      <p class="type-lead">15 minutes. No pressure, just a plan for your website.</p>
      <div class="thanks-book__embed">
        <div id="my-cal-inline-15min" class="thanks-book__cal" aria-label="Booking calendar"></div>
        <noscript>
          <p>Calendar needs JavaScript. Call <a href={`tel:${siteConfig.phone.replace(/[^0-9]/g, '')}`}>{siteConfig.phone}</a> or email <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a> to book.</p>
        </noscript>
      </div>
    </div>
  </section>

  <section class="thanks-next section-shell section-rule" aria-labelledby="next-title">
    <div class="site-container thanks-next__grid">
      <div>
        <p class="section-index">What happens next</p>
        <h2 id="next-title">Three simple steps.</h2>
        <ol class="thanks-steps">
          {nextSteps.map((step, index) => (
            <li data-reveal style={`--reveal-delay:${index * 70}ms`}>
              <span aria-hidden="true">{index + 1}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="thanks-prepare" data-reveal>
        <p class="section-index">Helpful to have ready</p>
        <h2>Speed things up.</h2>
        <ul>
          {prepare.map((item) => <li>{item}</li>)}
        </ul>
        <p class="thanks-prepare__note">
          Do not worry if you do not have it all. We will help you pull it together.
        </p>
      </div>
    </div>
  </section>

  <section class="thanks-links section-shell section-rule">
    <div class="site-container">
      <p class="section-index">While you wait</p>
      <div class="thanks-links__row">
        <a class="button" href="/portfolio/">Browse our work</a>
        <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        <a href={`tel:${siteConfig.phone.replace(/[^0-9]/g, '')}`}>{siteConfig.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .thanks-hero .type-lead {
    margin-top: 1.25rem;
  }

  .thanks-hero h1 [data-thanks-name]:empty {
    display: none;
  }

  .thanks-book h2,
  .thanks-next h2 {
    max-width: 18ch;
  }

  .thanks-book .type-lead {
    margin-top: 1rem;
  }

  .thanks-book__embed {
    margin-top: 2.5rem;
    overflow: hidden;
    border: 1px solid #f6e3d9;
    border-radius: 1.5rem;
    background: #fdf8f5;
  }

  .thanks-book__cal {
    width: 100%;
    min-height: 40rem;
  }

  .thanks-next__grid {
    display: grid;
    gap: 4rem;
  }

  .thanks-next h2 {
    margin-top: 1rem;
  }

  .thanks-steps {
    display: grid;
    gap: 0.75rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .thanks-steps li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    padding: 1.5rem;
    border-radius: 1rem;
    background: var(--bg-secondary);
  }

  .thanks-steps li > span {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-weight: var(--weight-bold);
  }

  .thanks-steps h3 {
    font-weight: var(--weight-bold);
  }

  .thanks-steps p {
    margin-top: 0.4rem;
    color: var(--text-secondary);
    font-size: var(--type-sm);
  }

  .thanks-prepare {
    align-self: start;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid #f6e3d9;
    border-radius: 1.5rem;
    background: #fdf8f5;
  }

  .thanks-prepare h2 {
    margin-top: 1rem;
  }

  .thanks-prepare ul {
    display: grid;
    gap: 0.75rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .thanks-prepare li {
    position: relative;
    padding-left: 1.5rem;
  }

  .thanks-prepare li::before {
    content: '';
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .thanks-prepare__note {
    margin-top: 1.5rem;
    color: var(--text-secondary);
    font-size: var(--type-sm);
  }

  .thanks-links__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .thanks-links__row > a:not(.button) {
    font-size: var(--type-sm);
    font-weight: var(--weight-bold);
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  @media (min-width: 900px) {
    .thanks-next__grid {
      grid-template-columns: 1.2fr 1fr;
      gap: 5rem;
    }
  }
</style>

<script is:inline>
  (function () {
    var lead = null;
    try { lead = JSON.parse(sessionStorage.getItem('swe-lead') || 'null'); } catch (e) {}
    var first = lead && lead.name ? String(lead.name).trim().split(/\s+/)[0] : '';
    var slot = document.querySelector('[data-thanks-name]');
    if (slot && first) slot.textContent = ', ' + first;

    (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");

    Cal("init", "15min", { origin: "https://app.cal.com" });

    var config = { layout: "month_view", useSlotsViewOnSmallScreen: "true" };
    if (lead && lead.name) config.name = lead.name;
    if (lead && lead.email) config.email = lead.email;

    Cal.ns["15min"]("inline", {
      elementOrSelector: "#my-cal-inline-15min",
      config: config,
      calLink: "emin-socalwebexperts/15min",
    });

    Cal.ns["15min"]("ui", {
      hideEventTypeDetails: false,
      layout: "month_view",
      cssVarsPerTheme: { light: { "cal-brand": "#f05423" }, dark: { "cal-brand": "#f05423" } },
    });
  })();
</script>
