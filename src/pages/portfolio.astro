---
import BaseLayout from '../layouts/BaseLayout.astro';
import Portfolio from '../components/sections/Portfolio.astro';
---

<BaseLayout
  title="Portfolio | Websites by SoCal Web Experts"
  description="See real websites we've built for law firms, auto dealers, medical practices, bakeries, and more — designed to convert local leads."
  keywords="web design portfolio Los Angeles, website examples Orange County, SoCal Web Experts work"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Portfolio', url: '/portfolio/' },
  ]}
>
  <Portfolio
    eyebrow="Portfolio"
    headingTop="Work built for"
    headingBottom="leads and trust"
    description="Modern design, clear messaging, and fast performance so customers choose you."
    headingLevel="h1"
    ctaHref="/contact/"
    ctaLabel="Want one like this? Get a Quote"
    ctaVariant="primary"
  />
</BaseLayout>
