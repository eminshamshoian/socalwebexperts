---
import type { GetStaticPaths } from 'astro';
import type { Service } from '../../types';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceExperience from '../../components/pages/ServiceExperience.astro';
import { services } from '../../data/site';
import { servicePageSchema } from '../../utils/seo';

export const getStaticPaths: GetStaticPaths = async () =>
  services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));

const { service } = Astro.props as { service: Service };

const serviceKeywords: Record<string, string> = {
  'web-design': 'custom web design Los Angeles, website designer Orange County, conversion focused websites Glendale',
  'social-media': 'social media marketing Los Angeles, Instagram management Orange County, social media agency SoCal',
  'google-ads': 'Google Ads management Los Angeles, PPC agency Orange County, local Google Ads Glendale',
};
---

<BaseLayout
  title={`${service.title} in Los Angeles and OC | SoCal Web Experts`}
  description={service.description}
  keywords={serviceKeywords[service.slug] || `${service.title} Los Angeles, ${service.title} Orange County`}
  ogImage={service.highlights[0].image}
  ogImageAlt={service.highlights[0].imageAlt}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Services', url: '/#services' },
    { name: service.title, url: `/services/${service.slug}/` },
  ]}
  jsonLd={servicePageSchema(service)}
>
  <ServiceExperience service={service} />
</BaseLayout>
