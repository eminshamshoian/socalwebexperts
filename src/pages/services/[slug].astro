---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import Button from '../../components/ui/Button.astro';
import CTA from '../../components/sections/CTA.astro';
import { services } from '../../data/site';
import { servicePageSchema } from '../../utils/seo';
import type { GetStaticPaths } from 'astro';
import type { Service } from '../../types';

export const getStaticPaths: GetStaticPaths = async () =>
  services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));

const { service } = Astro.props as { service: Service };
const relatedServices = services.filter((item) => item.id !== service.id);

const optimizedServiceImage = (src: string, width: number) => {
  const url = new URL(src);
  url.searchParams.set('auto', 'format');
  url.searchParams.set('fit', 'crop');
  url.searchParams.set('w', String(width));
  url.searchParams.set('q', '72');
  return url.toString();
};

const serviceImageSrcSet = (src: string) =>
  [480, 720, 960, 1280]
    .map((width) => `${optimizedServiceImage(src, width)} ${width}w`)
    .join(', ');

const serviceKeywords: Record<string, string> = {
  'web-design':
    'custom web design Los Angeles, website designer Orange County, conversion-focused websites Glendale',
  'social-media':
    'social media marketing Los Angeles, Instagram management Orange County, social media agency SoCal',
  'google-ads':
    'Google Ads management Los Angeles, PPC agency Orange County, local Google Ads Glendale',
};

const sectionHeadlines: Record<string, string> = {
  'web-design': 'Everything your website needs to earn attention and action.',
  'social-media': 'A practical social system that keeps your brand present.',
  'google-ads': 'Paid search built around qualified leads, not vanity metrics.',
};

const heroImage = service.highlights[0];
---

<BaseLayout
  title={`${service.title} in Los Angeles & OC | SoCal Web Experts`}
  description={service.description}
  keywords={serviceKeywords[service.slug] || `${service.title} Los Angeles, ${service.title} Orange County`}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Services', url: '/#services' },
    { name: service.title, url: `/services/${service.slug}/` },
  ]}
  jsonLd={servicePageSchema(service)}
>
  <article class="service-page">
    <section class="service-hero">
      <div class="service-hero__shape service-hero__shape--orbit" aria-hidden="true">
        <span></span>
      </div>
      <svg class="service-hero__shape service-hero__shape--line" viewBox="0 0 260 160" aria-hidden="true">
        <path d="M-15 125C45 25 125 12 275 76" />
        <path d="M-5 150C70 55 160 42 280 102" />
      </svg>

      <div class="service-container">
        <div class="service-hero__grid">
          <div class="service-hero__copy fade-in">
            <p class="type-eyebrow mb-6">What we do</p>

            <h1>{service.heroHeadline}</h1>
            <p class="type-lead service-hero__description">{service.description}</p>

            <div class="service-hero__actions">
              <Button href="/contact/" size="lg">
                Let's Discuss
                <Icon name="arrow-right" size={16} />
              </Button>
              <a href="#capabilities" class="service-text-link">
                See capabilities
                <Icon name="arrow-right" size={15} />
              </a>
            </div>
          </div>

          <div class="service-hero__visual fade-in" style="animation-delay: 0.1s;">
            <div class="service-hero__image-frame">
              <img
                src={optimizedServiceImage(heroImage.image, 1280)}
                srcset={serviceImageSrcSet(heroImage.image)}
                sizes="(max-width: 1023px) calc(100vw - 3rem), 46vw"
                alt={heroImage.imageAlt}
                width="1280"
                height="960"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
              <span class="service-hero__image-label">{service.title}</span>
            </div>
            <span class="service-hero__visual-mark" aria-hidden="true">
              <Icon name={service.icon} size={22} />
            </span>
          </div>
        </div>
      </div>
    </section>

    <section class="service-showcase" aria-labelledby="showcase-title">
      <div class="service-container">
        <div class="service-section-head fade-in">
          <div>
            <p class="type-eyebrow">The approach</p>
            <h2 id="showcase-title">Built to work in the real world.</h2>
          </div>
          <p class="type-lead">
            Clear thinking, useful creative, and a process designed around the customers you want to reach.
          </p>
        </div>

        <div class="service-showcase__grid">
          {service.highlights.map((item, index) => (
            <article
              class={`service-feature fade-in service-feature--${index + 1}`}
              style={`animation-delay: ${0.06 + index * 0.06}s`}
            >
              <div class="service-feature__media">
                <img
                  src={optimizedServiceImage(item.image, 960)}
                  srcset={serviceImageSrcSet(item.image)}
                  sizes="(max-width: 767px) calc(100vw - 3rem), 45vw"
                  alt={item.imageAlt}
                  width="960"
                  height="720"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="service-feature__copy">
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="capabilities" class="service-capabilities">
      <div class="service-container">
        <div class="service-section-head service-section-head--capabilities fade-in">
          <div>
            <p class="type-eyebrow">Capabilities</p>
            <h2>{sectionHeadlines[service.slug]}</h2>
          </div>
          <span class="service-capabilities__shape" aria-hidden="true">
            <svg viewBox="0 0 100 100">
              <circle cx="50" cy="50" r="42" />
              <path d="M8 50h84M50 8v84" />
            </svg>
          </span>
        </div>

        <div class="service-capabilities__grid">
          {service.details.map((detail, index) => (
            <article
              class="service-capability fade-in"
              style={`animation-delay: ${0.05 + index * 0.04}s`}
            >
              <div class="service-capability__top">
                <span class="service-capability__icon" aria-hidden="true">
                  <Icon name={detail.icon} size={17} />
                </span>
              </div>
              <h3>{detail.title}</h3>
              <p>{detail.description}</p>
            </article>
          ))}
        </div>

        <div class="service-related fade-in">
          <div class="service-related__head">
            <p class="type-eyebrow">Keep exploring</p>
            <h2>Related services</h2>
          </div>
          <div class="service-related__links">
            {relatedServices.map((related) => (
              <a href={`/services/${related.slug}/`} class="service-related__link group">
                <span class="service-related__icon" aria-hidden="true">
                  <Icon name={related.icon} size={17} />
                </span>
                <span>{related.title}</span>
                <Icon
                  name="arrow-right"
                  size={16}
                  class="service-related__arrow transition-transform group-hover:translate-x-1"
                />
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </article>

  <CTA />
</BaseLayout>

<style>
  .service-page {
    overflow: hidden;
  }

  .service-container {
    position: relative;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding-inline: 1.5rem;
  }

  @media (min-width: 1024px) {
    .service-container {
      padding-inline: 4rem;
    }
  }

  .service-hero {
    position: relative;
    padding-block: 5rem 6rem;
    border-bottom: 1px solid var(--border);
  }

  .service-hero__grid {
    display: grid;
    align-items: center;
    gap: 4rem;
  }

  @media (min-width: 1024px) {
    .service-hero {
      padding-block: 7rem 8rem;
    }

    .service-hero__grid {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
      gap: clamp(4rem, 8vw, 8rem);
    }
  }

  .service-hero__copy {
    position: relative;
    z-index: 2;
  }

  .service-hero h1 {
    max-width: 16ch;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .service-hero__description {
    max-width: 34rem;
    margin-top: 1.75rem;
  }

  .service-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: 2.25rem;
  }

  .service-text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    font-size: 0.875rem;
    font-weight: 400;
  }

  .service-text-link:hover {
    color: var(--color-primary-500);
  }

  .service-hero__visual {
    position: relative;
    z-index: 1;
  }

  .service-hero__image-frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--bg-secondary);
  }

  .service-hero__image-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgba(238, 233, 223, 0.06);
    border-radius: inherit;
    pointer-events: none;
  }

  .service-hero__image-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .service-hero__visual:hover img {
    transform: scale(1.025);
  }

  .service-hero__image-label {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid rgba(238, 233, 223, 0.15);
    border-radius: 999px;
    background: rgba(27, 38, 50, 0.78);
    color: var(--text);
    font-size: 0.75rem;
    font-weight: 400;
    backdrop-filter: blur(12px);
  }

  .service-hero__visual-mark {
    position: absolute;
    right: -1rem;
    top: -1rem;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--bg);
    color: var(--color-primary-500);
    animation: service-float 6s ease-in-out infinite;
  }

  .service-hero__shape {
    position: absolute;
    pointer-events: none;
    color: var(--color-primary-500);
  }

  .service-hero__shape--orbit {
    left: -9rem;
    top: 9rem;
    width: 20rem;
    height: 20rem;
    border: 1px solid rgba(255, 177, 98, 0.1);
    border-radius: 50%;
    animation: service-drift 14s ease-in-out infinite alternate;
  }

  .service-hero__shape--orbit::before,
  .service-hero__shape--orbit::after {
    content: '';
    position: absolute;
    border: 1px solid rgba(238, 233, 223, 0.06);
    border-radius: 50%;
  }

  .service-hero__shape--orbit::before {
    inset: 2rem;
  }

  .service-hero__shape--orbit::after {
    inset: 5rem;
  }

  .service-hero__shape--orbit span {
    position: absolute;
    right: 2.25rem;
    top: 2.8rem;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: currentColor;
  }

  .service-hero__shape--line {
    right: -3rem;
    bottom: -1rem;
    width: min(33vw, 28rem);
    opacity: 0.1;
  }

  .service-hero__shape--line path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
  }

  .service-showcase {
    padding-block: 6rem;
  }

  @media (min-width: 768px) {
    .service-showcase {
      padding-block: 8rem 10rem;
    }
  }

  .service-section-head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .service-section-head .type-eyebrow {
    margin-bottom: 1rem;
  }

  .service-section-head h2 {
    max-width: 12ch;
  }

  .service-section-head > .type-lead {
    max-width: 31rem;
  }

  @media (min-width: 768px) {
    .service-section-head {
      grid-template-columns: 1fr 0.8fr;
      align-items: end;
      gap: 4rem;
      margin-bottom: 6rem;
    }
  }

  .service-showcase__grid {
    display: grid;
    gap: 4rem 1.5rem;
  }

  @media (min-width: 768px) {
    .service-showcase__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 7rem 2rem;
    }

    .service-feature:nth-child(even) {
      transform: translateY(4rem);
    }
  }

  .service-feature__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 11;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--bg-secondary);
  }

  .service-feature__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .service-feature:hover .service-feature__media img {
    transform: scale(1.03);
  }

  .service-feature__copy {
    display: grid;
    gap: 0.75rem;
    padding-top: 1.25rem;
  }

  .service-feature__copy h3 {
    font-size: 1.35rem;
  }

  .service-feature__copy p,
  .service-capability p {
    max-width: 38rem;
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .service-capabilities {
    padding-block: 6rem 8rem;
    border-top: 1px solid var(--border);
  }

  @media (min-width: 768px) {
    .service-capabilities {
      padding-block: 8rem 10rem;
    }
  }

  .service-section-head--capabilities {
    position: relative;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
  }

  .service-section-head--capabilities h2 {
    max-width: 17ch;
  }

  .service-capabilities__shape {
    display: none;
    width: 6rem;
    color: var(--text-secondary);
    opacity: 0.18;
    animation: service-spin 28s linear infinite;
  }

  .service-capabilities__shape svg {
    display: block;
    width: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 0.8;
  }

  @media (min-width: 768px) {
    .service-capabilities__shape {
      display: block;
    }
  }

  .service-capabilities__grid {
    display: grid;
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--border);
  }

  @media (min-width: 768px) {
    .service-capabilities__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .service-capabilities__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .service-capability {
    min-height: 15rem;
    padding: 1.75rem;
    background: var(--bg);
    transition: background-color 0.3s ease;
  }

  .service-capability:hover {
    background: color-mix(in srgb, var(--bg-secondary) 34%, var(--bg));
  }

  .service-capability__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2.75rem;
  }

  .service-capability__icon,
  .service-related__icon {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--color-primary-500);
  }

  .service-capability h3 {
    margin-bottom: 0.75rem;
    font-size: 1.15rem;
  }

  .service-related {
    display: grid;
    gap: 2.5rem;
    margin-top: 6rem;
    padding-top: 4rem;
    border-top: 1px solid var(--border);
  }

  .service-related__head .type-eyebrow {
    margin-bottom: 0.75rem;
  }

  .service-related__head h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
  }

  .service-related__links {
    display: grid;
    gap: 0;
  }

  .service-related__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    font-size: 1rem;
    font-weight: 400;
  }

  .service-related__link:first-child {
    border-top: 1px solid var(--border);
  }

  .service-related__link:hover {
    color: var(--color-primary-500);
  }

  .service-related__arrow {
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .service-related {
      grid-template-columns: 0.7fr 1fr;
      gap: 5rem;
    }
  }

  @keyframes service-float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-8px) rotate(4deg); }
  }

  @keyframes service-drift {
    from { transform: translate3d(0, 0, 0) rotate(-4deg); }
    to { transform: translate3d(1.5rem, -1rem, 0) rotate(4deg); }
  }

  @keyframes service-spin {
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-hero__visual-mark,
    .service-hero__shape--orbit,
    .service-capabilities__shape {
      animation: none;
    }

    .service-feature:nth-child(even) {
      transform: none;
    }
  }
</style>
